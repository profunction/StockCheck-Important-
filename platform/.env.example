# Copy to .env and fill in. Never commit the filled-in version.

PORT=8787
PUBLIC_URL=https://pay.yourdomain.com

# Stripe -- dashboard.stripe.com/apikeys
# Use sk_test_... until a real payment has gone through end to end.
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe -- dashboard.stripe.com/webhooks, after adding the endpoint
# https://pay.yourdomain.com/webhook/stripe
# Without this the webhook refuses everything, which is correct: anyone on the
# internet can POST to that URL.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ToyyibPay -- for FPX. Local companies pay by bank transfer, not card.
TOYYIBPAY_SECRET_KEY=
TOYYIBPAY_CATEGORY_CODE=

# Defaults to ./service-account.json
# SERVICE_ACCOUNT_PATH=/etc/stockcheck/service-account.json
