    <string name="pos_others_title">Sistem POS lain</string>
    <string name="pos_others_body">StoreHub, Xilnex, Qashier, AutoCount, SQL POS, Shopify POS, EasyStore dan lain-lain: eksport laporan jualan dari sistem POS anda (Excel atau CSV) dan import di sini. Apa-apa susun atur boleh. Sambungan terus akan ditambah untuk setiap satu apabila pembekal itu memberi akses.</string>

    <!-- How to use -->
    <string name="guide_title">Cara guna</string>
    <string name="guide_intro">Setiap tugas langkah demi langkah. Langkah boleh dibaca tanpa internet; video pendek dimainkan dari laman web.</string>
    <string name="guide_count_title">Kira stok dengan telefon</string>
