    <string name="pos_title">Sambung sistem POS</string>
    <string name="pos_web_title">Pos Stock Check (laman web)</string>
    <string name="pos_web_body">Mesin kaunter kami sendiri untuk kedai, pasar raya, gudang dan restoran. Buka di komputer kaunter, log masuk dengan akaun yang sama, pasang pengimbas kod bar USB dan pencetak resit. Produk, gambar, harga dan stok dikongsi dengan aplikasi ini.</string>
