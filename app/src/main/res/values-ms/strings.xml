    <string name="guide_more_title">POS dan gudang</string>
    <string name="guide_more_body">Pos Stock Check (POS) dan Warehouse Stock Check ada panduan dan video sendiri di laman web.</string>
    <string name="guide_pos">Panduan POS</string>
    <string name="guide_warehouse">Panduan gudang</string>
