    <string name="guide_entry_sub">Panduan langkah demi langkah dan video</string>
    <string name="wh_web_title">Warehouse Stock Check (laman web)</string>
    <string name="wh_web_body">Pesanan belian, terima barang, pindahan antara gudang dan kedai, pelarasan dengan sebab dan log audit. Boleh guna di pelayar telefon dan dipasang sebagai aplikasi. Akaun, produk dan stok yang sama dengan aplikasi ini.</string>
    <string name="wh_web_open">Buka sistem gudang</string>
    <string-array name="guide_count_steps">
        <item>Tab Stok → kiraan baharu; pilih templat dan kawasan.</item>
        <item>Imbas kod bar dengan kamera dan isi kuantiti; atau sebut \"lima telur\", atau guna tag NFC.</item>
        <item>Selesai untuk lihat kurang atau lebih serta-merta.</item>
        <item>Eksport Excel atau CSV, atau cetak, dari Sejarah.</item>
    </string-array>
    <string-array name="guide_stock_steps">
        <item>Baki stok = kiraan terakhir + masuk dan keluar sejak itu.</item>
        <item>Import penghantaran dan jualan dari Excel atau CSV, atau sambung Loyverse.</item>
        <item>Jualan di Pos Stock Check menolak stok serta-merta; tetapkan paras tambah untuk peringatan.</item>
    </string-array>
    <string-array name="guide_team_steps">
        <item>Yang pertama mendaftar ialah admin; pekerja masuk dengan kod syarikat.</item>
        <item>Profil → Peranan: siapa boleh kira, lihat semua, ubah stok, guna POS dan gudang.</item>
        <item>Cawangan dan gudang berasingan; log audit menyimpan setiap perubahan.</item>
    </string-array>
    <string name="pos_loyverse_plan">Penyegerakan Loyverse ada dalam pelan Business dan Unlimited, serta pelan Stock Check App.</string>
</resources>
