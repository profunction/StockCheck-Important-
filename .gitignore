# Gradle / Android build output
.gradle/
build/
app/build/
captures/
*.apk
*.aab
*.ap_
*.dex

# Machine-specific SDK path
local.properties

# IDE
.idea/
*.iml
.kotlin/

# Signing material must never be committed.
# The release key itself lives outside this directory entirely; these
# patterns are the second line of defence, not the first.
*.jks
*.keystore
*.p12
*.pfx
keystore.properties

# OS noise
.DS_Store
Thumbs.db

# Firestore rules test harness deps
rules-test/node_modules/
rules-test/.firebase/
*-debug.log

# A service-account key bypasses every security rule. Never in git.
rules-test/service-account.json
service-account*.json

# Platform secrets: a service-account key is root on the database.
platform/service-account.json
platform/.env
platform/node_modules/
