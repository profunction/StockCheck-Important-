rules_version = '2';

// Server-side mirror of com.stockcheck.app.model.Permission.
//
// The app checks permissions before every write so the UI stays honest, but
// that check runs on a device the user controls. These rules are the boundary
// that actually holds: a modified client, a stolen token or a direct REST call
// is stopped here. Any permission added to the Kotlin enum that gates a write
// must be reflected below, or the write will succeed in the app and be denied
// on the server.
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------ company code registry
    //
    // The document id IS the code, so joining a company means reading a
    // document whose name you already had to be told. `get` is allowed and
    // `list` is refused, which is the whole security model here: a code
    // cannot be looked up, only confirmed.
    match /workspaceCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;

      // First to claim a code owns it. Never reassigned: repointing a code at
      // a different company would walk everyone who uses it into a stranger's
      // data on their next sign-up.
      allow create: if request.auth != null
                    && !exists(/databases/$(database)/documents/workspaceCodes/$(code))
                    && request.resource.data.workspaceId is string
                    && request.resource.data.workspaceId != ''
                    && request.resource.data.createdByUid == request.auth.uid;
      allow update, delete: if false;
    }

    // Whether the caller administers workspace [wsId].
    //
    // Firestore rules functions are scoped to the match block that declares
    // them, and /licences sits outside /workspaces/{ws}/ -- this is a top-
    // level collection keyed by a workspace id rather than nested under one.
    // match /userIndex/{uid} below needs the identical check and declares its
    // own copy for the same reason; two copies of one boolean cost less than
    // reaching across match blocks that were not designed to share.
    function isAdminOf(wsId) {
      return exists(/databases/$(database)/documents/workspaces/$(wsId)/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/workspaces/$(wsId)/users/$(request.auth.uid)).data.roleId == 'admin'
             && get(/databases/$(database)/documents/workspaces/$(wsId)/users/$(request.auth.uid)).data.active == true;
    }

    // ----------------------------------------------------------- licences
    //
    // What a company has paid for. Almost the only collection in this
    // database that no client may write.
    //
    // It cannot live under /workspaces/{ws}/meta, where the rule is
    // `allow write: if isAdmin()` -- that would let a customer's own admin set
    // their plan to lifetime and their expiry to 2099, and the whole billing
    // model would be decoration. Every change past the one below happens
    // through the Admin SDK, which bypasses these rules by design and runs on
    // the platform's machine with a service-account key, never on a phone.
    //
    // Readable by the company it belongs to, because the app has to show what
    // the plan is and how long is left. `list` stays shut: the collection is a
    // directory of every paying customer, their company name and contact.
    match /licences/{wsId} {
      allow get: if request.auth != null
                 && exists(/databases/$(database)/documents/userIndex/$(request.auth.uid))
                 && get(/databases/$(database)/documents/userIndex/$(request.auth.uid))
                      .data.workspaceId == wsId;
      allow list: if false;

      /**
       * The one exception: a brand-new company issuing itself the 14-day
       * trial every company gets.
       *
       * Requiring a licence to start a count only works if starting a
       * company does not begin with a refusal -- and the platform's own
       * startTrial() is a command someone has to remember to run by hand.
       * Without this, every signup sits locked out until whoever runs the
       * business notices and issues one, which for a prospect trying the
       * app unattended is never.
       *
       * `create` is what makes this safe to leave open: Firestore evaluates
       * a write as create only while the document does not yet exist, so
       * this can fire at most once per workspace no matter how many times a
       * modified client tries it, and `allow update, delete: if false` below
       * means it can never be reached again afterwards -- there is no path
       * from here to renewing, upgrading or extending anything.
       *
       * The shape is pinned to exactly what a trial is. A modified client
       * can still call this, but only to write TRIAL/ACTIVE/5 seats/a expiry
       * within the next 15 days (14 plus a day for clock drift) -- the same
       * terms startTrial() would have granted by hand, not a plan anyone
       * would rather buy.
       */
      allow create: if request.auth != null
                    && isAdminOf(wsId)
                    && request.resource.data.plan == 'TRIAL'
                    && request.resource.data.status == 'ACTIVE'
                    && request.resource.data.seats == 5
                    && request.resource.data.expiresAt > request.time.toMillis()
                    && request.resource.data.expiresAt
                         <= request.time.toMillis() + 15 * 24 * 60 * 60 * 1000;
      allow update, delete: if false;
    }

    // ------------------------------------------------------- user directory
    //
    // Which company an account belongs to. Written once at join time and
    // never changed: an account that could move itself between companies
    // would carry its role across with it.
    match /userIndex/{uid} {
      // Whether the caller administers the workspace they are pointing this
      // account at. Checked against that workspace's own membership, so an
      // admin of company A cannot place accounts into company B.
      function adminOf(wsId) {
        return exists(/databases/$(database)/documents/workspaces/$(wsId)/users/$(request.auth.uid))
               && get(/databases/$(database)/documents/workspaces/$(wsId)/users/$(request.auth.uid)).data.roleId == 'admin';
      }

      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;

      // Either you are indexing yourself while creating a company, or an
      // admin is issuing an account for a colleague.
      allow create: if request.auth != null
                    && request.resource.data.workspaceId is string
                    && request.resource.data.workspaceId != ''
                    && (request.auth.uid == uid
                        || adminOf(request.resource.data.workspaceId));
      allow update, delete: if false;
    }

    // --------------------------------------------------------- API tokens
    //
    // Keys for the POS API, so another system can read and write a
    // company's items, stock and receipts. Only the SHA-256 of a token is
    // stored -- the document id -- and the token itself is shown once. The
    // API server finds a company by hashing what it is sent. Only that
    // company's admin may make, list or revoke them.
    match /apiTokens/{hash} {
      allow read, delete: if request.auth != null && isAdminOf(resource.data.workspaceId);
      allow create: if request.auth != null
                    && isAdminOf(request.resource.data.workspaceId)
                    && request.resource.data.createdByUid == request.auth.uid
                    && hash.size() == 64;
      allow update: if false;
    }

    // ---------------------------------------------- the bot and notifications
    //
    // Connecting Telegram: the website leaves a one-off code here for its own
    // signed-in user, in their own company, for at most 20 minutes; the bot
    // (the API server, which these rules do not bind) reads it when the code
    // is sent as "/start <code>", files the chat and deletes the code. Nobody
    // can read a code back, so one seen over a shoulder is useless once used.
    match /telegramLinks/{code} {
      allow create: if request.auth != null
                    && code.size() >= 12
                    && request.resource.data.uid == request.auth.uid
                    && exists(/databases/$(database)/documents/userIndex/$(request.auth.uid))
                    && get(/databases/$(database)/documents/userIndex/$(request.auth.uid)).data.workspaceId
                         == request.resource.data.workspaceId
                    && request.resource.data.expiresAt <= request.time.toMillis() + 20 * 60 * 1000;
      allow read, update, delete: if false;
    }

    // A linked chat: written only by the bot. Its owner sees it, may turn
    // the morning report off and on, and may disconnect it.
    match /telegramChats/{chatId} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && resource.data.uid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['daily'])
                    && request.resource.data.daily is bool;
      allow create: if false;
    }

    // The bot's name and the browser push key: public facts the server
    // publishes for the website.
    match /publicConfig/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Keys to other companies' systems (connections): read and written by
    // the API server only, never by a browser -- not even the owner's.
    match /connectionSecrets/{id} {
      allow read, write: if false;
    }

    match /workspaces/{ws} {

      // ------------------------------------------------------------ helpers

      function signedIn() {
        return request.auth != null;
      }

      function profile() {
        return get(/databases/$(database)/documents/workspaces/$(ws)/users/$(request.auth.uid)).data;
      }

      function profileExists() {
        return exists(/databases/$(database)/documents/workspaces/$(ws)/users/$(request.auth.uid));
      }

      function active() {
        return signedIn() && profileExists() && profile().active == true;
      }

      function roleDoc() {
        return get(/databases/$(database)/documents/workspaces/$(ws)/roles/$(profile().roleId)).data;
      }

      // The admin role is authoritative in code, not in its stored permission
      // list, so an admin who empties that list is still an admin here.
      function isAdmin() {
        return active() && profile().roleId == 'admin';
      }

      function can(perm) {
        return isAdmin() || (active() && perm in roleDoc().permissions);
      }

      function isOwner(uid) {
        return active() && request.auth.uid == uid;
      }

      /**
       * Whether this account may look at a count made at that branch.
       *
       * An account with no branches listed sees every one of them: that is
       * head office, it is the default, and it is what keeps adding branches
       * to a company that already has history from locking anybody out.
       *
       * A count carrying no branch is visible to everyone, because most
       * customers run one shop and will never set one -- hiding those from a
       * branch manager would hide the company's entire past from them.
       *
       * `get(...)` on a list field that an older profile does not have
       * returns the default, so an account written before branches existed
       * reads as head office rather than as nobody.
       */
      function myBranches() {
        return profile().get('branchIds', []);
      }

      // `record.branchId`, not `record.get('branchId', '')`. A query that
      // does not constrain branchId leaves it unknown, and get()'s default
      // let the rule be satisfied anyway -- so a branch account's unfiltered
      // query was allowed and returned every branch's counts. Reading the
      // field directly is an error when it is unknown, which refuses that
      // query unless the account owns everything it could match.
      // rules-test/branch-test.mjs has the case.
      //
      // The cost: a count saved before counts carried a branch has no
      // branchId field, so a branch account cannot open one it did not
      // make. Head office still can.
      function inMyBranch(record) {
        return myBranches().size() == 0
               || record.branchId == ''
               || record.branchId in myBranches();
      }

      // Fields the client is never allowed to set or move.
      function keepsAuthor(existing) {
        return request.resource.data.createdByUid == existing.createdByUid;
      }

      function configPath() {
        return /databases/$(database)/documents/workspaces/$(ws)/meta/config;
      }

      /**
       * Gates self-registration on the company code.
       *
       * The code lives in meta/config, which only members may read — so
       * someone registering cannot look it up, they have to have been told
       * it. Rules can read it regardless, which is what makes this a real
       * check rather than a prompt the client could skip.
       *
       * Before any config exists the workspace is being set up by its first
       * user, who has nobody to get a code from; that case is allowed and
       * closes as soon as the admin sets one.
       */
      function licencePath() {
        return /databases/$(database)/documents/licences/$(ws);
      }

      /**
       * Whether this company may start new work.
       *
       * Stops starting a count and nothing else. Reading, finishing an open
       * count and exporting stay available at every status, because holding
       * data hostage over a lapsed card is how a billing problem becomes a
       * complaint to the Ministry.
       *
       * Registration is deliberately NOT gated on this. A company's first
       * user signs up before any licence has been written for it, so gating
       * accounts here would mean nobody could ever sign up in the first
       * place. An earlier version of this comment claimed expiry stopped new
       * accounts too; it never did, and it must not.
       */
      // A workspace with no licence may not start a count. One holding a
      // licence that is ACTIVE and unexpired may.
      //
      // Every company gets a licence written for it -- a free trial
      // included -- the moment it registers: AuthRepository.createCompany
      // calls LicenceRepository.startTrial right after the new admin's own
      // profile is written, and the create-only exception below on
      // /licences/{wsId} is what lets that self-service write through. So
      // absent means nobody has been sold anything yet, not a customer who
      // slipped past the paywall.
      //
      // This and the matching `== true` on StockHomeScreen.kt's `mayStart`
      // move together -- the app's check alone is one a modified client can
      // delete, and this one alone refuses a write the app has already said
      // would work.
      //
      // Only the platform's service account can write /licences (past the
      // one exception below), so this is a rule a modified client cannot
      // argue with.
      function licenceAllowsNewWork() {
        return exists(licencePath())
               && get(licencePath()).data.status == 'ACTIVE'
               && (get(licencePath()).data.expiresAt == 0
                   || get(licencePath()).data.expiresAt > request.time.toMillis());
      }

      // A part of the product the company's plan leaves out (PLANS in
      // platform/plans.mjs; the same rule as isEnabled() in web/js/modules.js
      // for a licence with a modules map): the till on the app-only pack,
      // counting on the till-only pack, the warehouse on both. A licence from before plans had modules has none,
      // and keeps everything it had.
      function moduleOff(name) {
        return exists(licencePath())
               && ('modules' in get(licencePath()).data)
               && get(licencePath()).data.modules.get(name, true) == false;
      }

      // JSOX Books comes with the POS, or on its own (the Books plan).
      function booksOff() {
        return moduleOff('pos')
               && !(exists(licencePath()) && ('modules' in get(licencePath()).data)
                    && get(licencePath()).data.modules.get('books', false) == true);
      }

      // Whether the caller claimed company code [code] for this workspace --
      // i.e. is the person who created the company.
      function foundedBy(code) {
        return code is string && code != ''
               && exists(/databases/$(database)/documents/workspaceCodes/$(code))
               && get(/databases/$(database)/documents/workspaceCodes/$(code)).data.workspaceId == ws
               && get(/databases/$(database)/documents/workspaceCodes/$(code)).data.createdByUid == request.auth.uid;
      }

      function joinCodeAccepted() {
        return !exists(configPath())
               || get(configPath()).data.joinCode == ''
               || request.resource.data.get('joinCode', '') == get(configPath()).data.joinCode;
      }

      // ------------------------------------------------------------- users

      match /users/{uid} {
        // Self-registration writes exactly one document: the user's own,
        // active, and never onto the admin role.
        //
        // There is deliberately no check on a `uid` FIELD in the document
        // body. UserProfile.uid is annotated @DocumentId, which means the SDK
        // fills it from the document id when reading and OMITS it when
        // writing -- so a body check reads as "Property uid is undefined on
        // object" and denies every registration. The document id IS the uid,
        // and the `request.auth.uid == uid` line above already pins it to the
        // caller, so the field check added nothing but a deadlock.
        allow create: if signedIn()
                      && request.resource.data.active == true
                      && (
                           // Creating a company: you write your own profile,
                           // and only an unclaimed workspace may hand out the
                           // admin role that way.
                           //
                           // The admin role only for the person who claimed
                           // this company's code (workspaceCodes/{code}
                           // records who did): knowing a company's code is
                           // how staff join it, and must never be enough to
                           // join it as its admin.
                           //
                           // Everyone else who signs up with the code starts
                           // as a worker, the least a role can do; both apps
                           // only ever ask for that. Choosing any other role
                           // here would let a modified app join as a manager.
                           (request.auth.uid == uid
                            && (request.resource.data.roleId == 'worker'
                                || (request.resource.data.roleId == 'admin'
                                    && !profileExists() && foundedBy(request.resource.data.get('joinCode', ''))))
                            && joinCodeAccepted())
                           // Or someone allowed to add staff is issuing an
                           // account for a colleague, in which case the code
                           // is irrelevant: staff never type one. Only an
                           // admin may make another admin.
                           || (can('CREATE_USER')
                               && (isAdmin() || request.resource.data.roleId != 'admin'))
                         );

        allow read: if isOwner(uid) || can('VIEW_USERS');

        // A user may refresh their own lastSeenAt but may not promote
        // themselves: role, active and branches are reserved for user
        // administrators. A branch manager who could empty their own
        // branchIds would be head office the moment they thought of it.
        //
        // Someone given user administration without being an admin (a custom
        // role with EDIT_USER, say, for whoever does HR) manages the others:
        // never their own record past what anyone may change, never an admin,
        // and never into the admin role. Otherwise they could promote
        // themselves to admin, or demote the owner.
        allow update: if (isOwner(uid)
                          && request.resource.data.roleId == resource.data.roleId
                          && request.resource.data.active == resource.data.active
                          && request.resource.data.get('branchIds', [])
                               == resource.data.get('branchIds', []))
                      || isAdmin()
                      || ((can('EDIT_USER') || can('CHANGE_PERMISSION'))
                          && request.auth.uid != uid
                          && resource.data.roleId != 'admin'
                          && request.resource.data.roleId != 'admin');

        // An admin may remove somebody else, and anybody may remove
        // themselves -- the second is what Google Play requires of any app
        // that lets people create an account, and it is the only deletion
        // that works without the Admin SDK and a paid plan behind it.
        allow delete: if (can('DELETE_USER') && request.auth.uid != uid
                          && (isAdmin() || resource.data.roleId != 'admin'))
                      || isOwner(uid);

        // Where this person's phones and browsers receive notifications.
        match /pushTokens/{token} {
          allow read, write: if isOwner(uid);
        }
      }

      // ------------------------------------------------------------- roles

      match /roles/{roleId} {
        allow read: if active();
        // Seeding writes all four built-in roles in one atomic batch while
        // the workspace still has no admin role, which is the only moment a
        // caller without a profile is allowed to create roles at all.
        //
        // Every write in a batch is evaluated against the pre-batch state, so
        // all four see !exists(roles/admin) as true regardless of the order
        // they appear in the batch -- verified in rules-test/test.mjs, which
        // asserts both orderings pass.
        allow create: if can('CREATE_ROLE')
                      || (signedIn() && !exists(/databases/$(database)/documents/workspaces/$(ws)/roles/admin));
        // Not the role you hold yourself, unless you are an admin: whoever
        // could edit their own role could hand themselves every permission.
        allow update: if can('EDIT_ROLE') && roleId != 'admin'
                      && (isAdmin() || roleId != profile().roleId);
        allow delete: if can('DELETE_ROLE') && resource.data.builtIn == false;
      }

      // ---------------------------------------------------------- products

      match /products/{barcode} {
        // Every member reads the catalogue: a scan resolves a name from it on
        // the counting screen, so a worker who could not read it would be back
        // to bare numbers.
        allow read: if active();
        // Creating is naming a barcode that had no name: the counter who just
        // scanned it is exactly the right person, so this stays open to them.
        // POS_MANAGE: whoever runs the till's product list adds items from
        // the website, photos and prices included.
        allow create: if can('CREATE_STOCK_CHECK') || can('EDIT_TEMPLATE') || can('POS_MANAGE');
        // Overwriting an entry that already exists is the other act -- what a
        // spreadsheet import does to the whole catalogue at once -- and that
        // needs the permission granted for it. The rules cannot see that four
        // hundred writes arrived as one import, but they can see that each one
        // lands on a product somebody already named.
        allow update: if can('IMPORT_PRODUCTS') || can('EDIT_TEMPLATE') || can('POS_MANAGE')
                      // Whoever keeps the stock may say when it is low, how
                      // many come in a carton and which shelf it is on, and
                      // nothing else: not rename it, not deactivate it.
                      || (can('RECORD_STOCK_MOVEMENTS')
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['reorderLevelMilli', 'packSize', 'packName', 'shelves', 'updatedAt']))
                      // The buyer sets reorder points, the most to hold, who
                      // to buy from and what it costs -- still not the name
                      // or the selling price.
                      || (can('WH_PURCHASE')
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['reorderLevelMilli', 'maxStockMilli', 'preferredSupplierId', 'costSen', 'packSize', 'packName', 'shelves', 'updatedAt']));
        allow delete: if can('EDIT_TEMPLATE') || can('POS_MANAGE');
      }

      // ---------------------------------------------------- stock movements
      //
      // Goods in and out between counts. Branch-scoped like counts: head
      // office reads them all, a branch account queries
      // whereIn(branchId, its branches + "").
      match /movements/{movementId} {
        function wellFormed(data) {
          return data.type in ['RECEIVE', 'SALE', 'REFUND', 'WRITE_OFF', 'TRANSFER_OUT', 'TRANSFER_IN']
                 && data.quantityMilli is int
                 && data.quantityMilli >= 0
                 && data.barcode is string
                 && data.barcode != ''
                 && inMyBranch(data);
        }

        allow read: if active() && inMyBranch(resource.data);
        // Update as well as create: an import writes the same id again to
        // replace what it wrote before, which is what stops a re-import from
        // counting a day's sales twice.
        allow create, update: if can('RECORD_STOCK_MOVEMENTS') && wellFormed(request.resource.data);
        // The till takes what it sells off the shelf, and a voided sale puts
        // it back -- and nothing else. A cashier cannot record a delivery or
        // a write-off, and cannot rewrite one already there.
        allow create: if wellFormed(request.resource.data)
                      && request.resource.data.source == 'POS'
                      && request.resource.data.createdByUid == request.auth.uid
                      && ((can('POS_SELL') && request.resource.data.type == 'SALE')
                          || (can('POS_VOID') && request.resource.data.type == 'REFUND'));
        allow delete: if can('RECORD_STOCK_MOVEMENTS') && inMyBranch(resource.data);
      }

      // ------------------------------------------------------ POS: sales
      //
      // One document per receipt, written by the POS website. A sale is
      // never edited or deleted -- money is not something a record gets to
      // forget -- only voided, which keeps it and says who and why.
      match /sales/{saleId} {
        function saleShape(d) {
          return d.cashierUid == request.auth.uid
                 && d.status == 'COMPLETED'
                 && d.totalSen is int
                 && d.lines is list
                 && d.payments is list
                 && d.createdAt is int
                 && inMyBranch(d);
        }

        // A cashier sees their own receipts (reprint, today's takings);
        // reports see the branch's.
        allow read: if active()
                    && ((can('POS_SELL') && resource.data.cashierUid == request.auth.uid)
                        || (can('POS_REPORTS') && inMyBranch(resource.data)));
        allow create: if can('POS_SELL') && saleShape(request.resource.data) && !moduleOff('pos');
        allow update: if (can('POS_VOID')
                         && inMyBranch(resource.data)
                         && resource.data.status == 'COMPLETED'
                         && request.resource.data.status == 'VOIDED'
                         && request.resource.data.voidedByUid == request.auth.uid
                         && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['status', 'voidedAt', 'voidedByUid', 'voidedByName', 'voidReason']))
                      // PDPA: a customer erased after their 90 days leaves
                      // their receipts, with the amounts, but not their name.
                      // Blanking is all this allows.
                      || (can('POS_MANAGE')
                          && inMyBranch(resource.data)
                          && request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['customerId', 'customerName', 'customerPhone', 'customerErased'])
                          && request.resource.data.customerId == ''
                          && request.resource.data.customerName == ''
                          && request.resource.data.customerPhone == ''
                          && request.resource.data.customerErased == true);
        allow delete: if false;
      }

      // ------------------------------------------------------ POS: shifts
      //
      // A cashier's shift: the float they start with, then the counted cash
      // against what should be in the drawer. Opened by the cashier
      // themselves; closed by them or a manager. A closed shift is history
      // and never changes again.
      match /shifts/{shiftId} {
        allow read: if active()
                    && (resource.data.operatorId == request.auth.uid
                        || ((can('POS_REPORTS') || can('POS_MANAGE')) && inMyBranch(resource.data)));
        allow create: if can('POS_SELL')
                      && request.resource.data.operatorId == request.auth.uid
                      && request.resource.data.status == 'OPEN'
                      && request.resource.data.floatSen is int
                      && request.resource.data.floatSen >= 0
                      && request.resource.data.openedAt is int
                      && inMyBranch(request.resource.data);
        allow update: if resource.data.status == 'OPEN'
                      && ((can('POS_SELL') && resource.data.operatorId == request.auth.uid)
                          || (can('POS_MANAGE') && inMyBranch(resource.data)))
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'cashMoves', 'updatedAt', 'closedAt', 'closedByUid', 'closedByName',
                                     'summary', 'expectedCashSen', 'actualCashSen', 'shortOverSen'])
                      && request.resource.data.status in ['OPEN', 'CLOSED']
                      && (request.resource.data.status == 'OPEN'
                          || (request.resource.data.actualCashSen is int
                              && request.resource.data.shortOverSen is int
                              && request.resource.data.closedByUid == request.auth.uid));
        allow delete: if false;
      }

      // The computers a company sells on, for the till limit of its plan.
      match /tills/{tillId} {
        allow read, create, update: if can('POS_SELL') || can('POS_MANAGE');
        allow delete: if can('POS_MANAGE');
      }

      // ---------------------------------------------- POS: open orders
      //
      // A restaurant table's bill while it is still being eaten, or a held
      // retail sale. Shared by every till in the branch, so a waiter's order
      // shows at the counter. Deleted once paid: the sale is the record.
      match /orders/{orderId} {
        allow read: if can('POS_SELL') && inMyBranch(resource.data);
        allow create, update: if can('POS_SELL') && inMyBranch(request.resource.data);
        allow delete: if can('POS_SELL') && inMyBranch(resource.data);
      }

      // Orders customers send from their own phones by QR code. Only the
      // API writes them (it prices them from the items, never the phone);
      // the till reads them and accepts, marks ready or turns one down --
      // and may change nothing else on it.
      match /selfOrders/{id} {
        allow read: if can('POS_SELL') && inMyBranch(resource.data);
        allow update: if can('POS_SELL') && inMyBranch(resource.data)
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'open', 'mergedInto', 'rejectReason', 'handledByName', 'updatedAt'])
                      && request.resource.data.status in ['ACCEPTED', 'READY', 'DONE', 'REJECTED'];
        allow create, delete: if false;
      }
      // The pickup numbers' daily counters: the API's alone.
      match /selfOrderDays/{id} {
        allow read, write: if false;
      }

      // ------------------------------------------------- POS: customers
      //
      // Names, phone numbers and loyalty points. Anyone at the till looks a
      // customer up and adds one; points move with each sale.
      match /customers/{customerId} {
        function posStaff() {
          return can('POS_SELL') || can('POS_MANAGE') || can('POS_REPORTS');
        }
        allow read: if posStaff();
        allow create, update: if can('POS_SELL') || can('POS_MANAGE');
        allow delete: if can('POS_MANAGE');
      }

      // --------------------------------------------------- purchase orders
      //
      // What was ordered from a supplier and what of it has arrived.
      //
      // DRAFT -> SUBMITTED -> APPROVED -> ORDERED -> PARTIAL -> RECEIVED
      // -> CLOSED, or CANCELLED. Raising one is the buyer's; moving it into
      // an approved state is the approver's (an admin is both). Whoever
      // receives goods may then record what arrived against it, and nothing
      // else: not the prices, not the quantities ordered.
      match /purchaseOrders/{poId} {
        function buyer() {
          return can('POS_MANAGE') || can('WH_PURCHASE');
        }
        function approvedState(status) {
          return status in ['APPROVED', 'ORDERED', 'PARTIAL', 'RECEIVED', 'CLOSED'];
        }
        // Entering an approved state from one that was not is approving it.
        function approvalHeld(before, after) {
          return !approvedState(after) || approvedState(before) || can('WH_APPROVE');
        }
        function receiving() {
          return can('RECORD_STOCK_MOVEMENTS')
                 && resource.data.status in ['ORDERED', 'PARTIAL']
                 && request.resource.data.status in ['ORDERED', 'PARTIAL', 'RECEIVED']
                 && request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['lines', 'status', 'receivedAt', 'updatedAt']);
        }
        allow read: if (buyer() || can('WH_APPROVE') || can('RECORD_STOCK_MOVEMENTS')) && inMyBranch(resource.data);
        allow create: if buyer() && inMyBranch(request.resource.data)
                      && approvalHeld('DRAFT', request.resource.data.status)
                      && !moduleOff('warehouse');
        allow update: if inMyBranch(resource.data) && inMyBranch(request.resource.data)
                      && approvalHeld(resource.data.status, request.resource.data.status)
                      && (buyer() || can('WH_APPROVE') || receiving());
        allow delete: if buyer() && inMyBranch(resource.data) && resource.data.status == 'DRAFT';
      }

      // ---------------------------------------------------------- receiving
      //
      // One delivery checked in: per line what was ordered, what arrived,
      // what was damaged or turned away, with the delivery note number. The
      // stock it adds is RECEIVE movements written in the same batch. Never
      // edited and never deleted -- it is the record of what the driver
      // handed over -- and its id is made on the phone, so a delivery saved
      // twice over a bad connection is refused the second time rather than
      // received twice.
      match /receivings/{receivingId} {
        allow read: if (can('RECORD_STOCK_MOVEMENTS') || can('WH_PURCHASE') || can('POS_MANAGE') || can('WH_APPROVE'))
                    && inMyBranch(resource.data);
        allow create: if can('RECORD_STOCK_MOVEMENTS')
                      && inMyBranch(request.resource.data)
                      && request.resource.data.createdByUid == request.auth.uid
                      && request.resource.data.lines is list
                      && !moduleOff('warehouse');
        allow update, delete: if false;
      }

      // --------------------------------------------------------- transfers
      //
      // Stock sent from one branch to another. The sender records it going
      // out, the receiving branch records it arriving -- each only at a
      // branch it belongs to, through the movement rules above.
      match /transfers/{transferId} {
        function eitherEnd(d) {
          return myBranches().size() == 0
                 || d.fromBranch in myBranches()
                 || d.toBranch in myBranches();
        }
        // When the company asks for it (pos/settings.transferApproval), a
        // transfer leaves only once approved: DRAFT -> PENDING -> APPROVED
        // -> SENT. Approving is the approver's; so is sending one straight
        // out while approval is on (an approver needs nobody's say-so).
        function approvalOn() {
          return exists(/databases/$(database)/documents/workspaces/$(ws)/pos/settings)
                 && get(/databases/$(database)/documents/workspaces/$(ws)/pos/settings).data.get('transferApproval', false) == true;
        }
        function approvalKept(before, after) {
          return (after != 'APPROVED' || before == 'APPROVED' || can('WH_APPROVE'))
                 && (after != 'SENT' || before in ['SENT', 'APPROVED'] || can('WH_APPROVE') || !approvalOn());
        }
        allow read: if (can('RECORD_STOCK_MOVEMENTS') || can('WH_APPROVE')) && eitherEnd(resource.data);
        // Starting one needs the warehouse part; one already on its way can
        // always be received, whatever the plan became since.
        allow create: if can('RECORD_STOCK_MOVEMENTS') && eitherEnd(request.resource.data) && !moduleOff('warehouse')
                      && approvalKept('DRAFT', request.resource.data.status);
        allow update: if can('RECORD_STOCK_MOVEMENTS') && eitherEnd(request.resource.data)
                      && approvalKept(resource.data.status, request.resource.data.status)
                      // What was approved is what leaves.
                      && (resource.data.status != 'APPROVED' || can('WH_APPROVE')
                          || (request.resource.data.lines == resource.data.lines
                              && request.resource.data.fromBranch == resource.data.fromBranch
                              && request.resource.data.toBranch == resource.data.toBranch));
        // An approver who does not move stock may approve or send back, and
        // touch nothing else.
        allow update: if can('WH_APPROVE') && eitherEnd(resource.data)
                      && resource.data.status == 'PENDING'
                      && request.resource.data.status in ['APPROVED', 'DRAFT']
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'approvedByUid', 'approvedByName', 'approvedAt', 'updatedAt']);
        allow delete: if can('RECORD_STOCK_MOVEMENTS') && eitherEnd(resource.data) && resource.data.status == 'DRAFT';
      }

      // ---------------------------------------------------- supplier returns
      //
      // Goods sent back to a supplier. The stock leaves in the same batch
      // (WRITE_OFF movements, reason SUPPLIER_RETURN); the record then only
      // waits for the supplier's credit note, which the buyer notes.
      match /supplierReturns/{returnId} {
        allow read: if (can('RECORD_STOCK_MOVEMENTS') || can('WH_PURCHASE') || can('POS_MANAGE') || can('WH_APPROVE'))
                    && inMyBranch(resource.data);
        allow create: if can('RECORD_STOCK_MOVEMENTS')
                      && inMyBranch(request.resource.data)
                      && request.resource.data.createdByUid == request.auth.uid
                      && request.resource.data.status == 'OPEN'
                      && request.resource.data.lines is list
                      && !moduleOff('warehouse');
        allow update: if (can('WH_PURCHASE') || can('POS_MANAGE'))
                      && inMyBranch(resource.data)
                      && resource.data.status == 'OPEN'
                      && request.resource.data.status == 'CREDITED'
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'creditNo', 'creditSen', 'creditedAt', 'creditedByName', 'updatedAt']);
        allow delete: if false;
      }

      // ------------------------------------------------------ reservations
      //
      // Stock promised to a customer: still on the shelf, not free to
      // promise again. Held, then delivered (a SALE movement in the same
      // batch) or released.
      match /reservations/{resId} {
        allow read: if (can('RECORD_STOCK_MOVEMENTS') || can('POS_MANAGE') || can('WH_PURCHASE')) && inMyBranch(resource.data);
        allow create: if (can('RECORD_STOCK_MOVEMENTS') || can('POS_MANAGE'))
                      && inMyBranch(request.resource.data)
                      && request.resource.data.status == 'OPEN'
                      && request.resource.data.lines is list
                      && !moduleOff('warehouse');
        allow update: if (can('RECORD_STOCK_MOVEMENTS') || can('POS_MANAGE'))
                      && inMyBranch(resource.data)
                      && resource.data.status == 'OPEN'
                      && request.resource.data.status in ['DELIVERED', 'RELEASED']
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'closedAt', 'closedByName', 'updatedAt']);
        allow delete: if false;
      }

      // ---------------------------------------------------------- picklists
      //
      // One walk along the shelves for several orders (web/wh/picking.js).
      // It moves no stock -- the transfer or reservation it serves does --
      // so it only records who picked what: WAITING -> PICKING -> DONE, or
      // CANCELLED. Made by its maker; never deleted; a finished one is kept.
      match /picklists/{pickId} {
        allow read: if can('RECORD_STOCK_MOVEMENTS') && inMyBranch(resource.data);
        allow create: if can('RECORD_STOCK_MOVEMENTS')
                      && inMyBranch(request.resource.data)
                      && request.resource.data.createdByUid == request.auth.uid
                      && request.resource.data.status == 'WAITING'
                      && request.resource.data.lines is list
                      && request.resource.data.orders is list
                      && !moduleOff('warehouse');
        allow update: if can('RECORD_STOCK_MOVEMENTS')
                      && inMyBranch(resource.data)
                      && resource.data.status in ['WAITING', 'PICKING']
                      && request.resource.data.status in ['WAITING', 'PICKING', 'DONE', 'CANCELLED']
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'lines', 'pickerUid', 'pickerName', 'startedAt', 'doneAt', 'cancelledAt', 'cancelledByName', 'updatedAt'])
                      && (request.resource.data.pickerUid == resource.data.pickerUid || request.resource.data.pickerUid == request.auth.uid);
        allow delete: if false;
      }

      // ----------------------------------------------------------- outbound
      //
      // Packing an order going out (web/wh/outbound.js): marked urgent,
      // packed into cartons and set down in a staging lane, then loaded on
      // the lorry at a dock. One per order (id TR-<transfer> / RS-<reservation>);
      // it moves no stock -- the transfer or reservation does. Which order
      // and where it is kept never change; never deleted.
      match /outbound/{packId} {
        allow read: if can('RECORD_STOCK_MOVEMENTS') && inMyBranch(resource.data);
        allow create: if can('RECORD_STOCK_MOVEMENTS')
                      && inMyBranch(request.resource.data)
                      && request.resource.data.createdByUid == request.auth.uid
                      && request.resource.data.kind in ['TRANSFER', 'RESERVATION']
                      && request.resource.data.orderId is string
                      && request.resource.data.status in ['OPEN', 'PACKED']
                      && !moduleOff('warehouse');
        allow update: if can('RECORD_STOCK_MOVEMENTS')
                      && inMyBranch(resource.data)
                      && request.resource.data.status in ['OPEN', 'PACKED', 'LOADED']
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'urgent', 'cartons', 'weightKg', 'lane', 'station', 'packedAt', 'packedByName', 'tripId', 'dock', 'loadedAt', 'loadedByName', 'updatedAt']);
        allow delete: if false;
      }

      // ------------------------------------------------- automatic dispatch
      //
      // A warehouse switched to Auto (web/wh/auto.js): a manager turns it on
      // or off; any WMS screen there may take the lease (only in its own
      // name) and note when it last ran. Never deleted.
      match /whAuto/{placeId} {
        allow read: if can('RECORD_STOCK_MOVEMENTS');
        allow create, update: if !moduleOff('warehouse') && (
          ((isAdmin() || can('WH_APPROVE'))
             && request.resource.data.on is bool
             && request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys()
                  .hasOnly(['on', 'updatedAt', 'updatedByName', 'updatedByUid']))
          || (resource != null && can('RECORD_STOCK_MOVEMENTS')
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leaseBy', 'leaseUntil', 'lastRun', 'lastDone'])
             && request.resource.data.get('leaseBy', '') == request.auth.uid));
        allow delete: if false;
      }

      // ------------------------------------------- connections to other systems
      //
      // Where another system's data comes from (a friend's POS, someone
      // else's WMS or TMS): set up by the owner; seen by those who see the
      // figures. The keys are not here (connectionSecrets/, server only); the
      // server writes when it last fetched.
      match /connections/{connId} {
        allow read: if isAdmin() || can('POS_REPORTS') || can('POS_MANAGE') || can('WH_APPROVE') || can('BOOKS_ADMIN') || can('BOOKS_POST');
        allow create, update: if isAdmin()
                              && request.resource.data.name is string
                              && request.resource.data.mode in ['PULL', 'PUSH']
                              && request.resource.data.feeds is list;
        allow delete: if isAdmin();
      }

      // ------------------------------------------------------- JSOX TMS
      //
      // Lorries and drivers (a manager keeps them), drivers' shifts (clock
      // in, then clock out -- nothing else changes), and trips with their
      // stops and signed proof of delivery (web/tm/). Moves no stock: the
      // transfer is still received, the reservation still handed over, in
      // the WMS. None is ever deleted; a lorry or driver is switched off.
      function tmsManager() {
        return isAdmin() || can('WH_APPROVE') || can('POS_MANAGE');
      }
      function tmsReader() {
        return can('RECORD_STOCK_MOVEMENTS') || tmsManager();
      }
      match /tmsLorries/{lorryId} {
        allow read: if tmsReader();
        allow create, update: if tmsManager() && request.resource.data.plate is string && request.resource.data.plate.size() > 0 && !moduleOff('warehouse');
        allow delete: if false;
      }
      match /tmsDrivers/{driverId} {
        allow read: if tmsReader();
        allow create, update: if tmsManager() && request.resource.data.name is string && request.resource.data.name.size() > 0 && !moduleOff('warehouse');
        allow delete: if false;
      }
      match /tmsShifts/{shiftId} {
        allow read: if tmsReader();
        allow create: if can('RECORD_STOCK_MOVEMENTS')
                      && request.resource.data.createdByUid == request.auth.uid
                      && request.resource.data.outAt == null
                      && request.resource.data.inAt is int
                      && !moduleOff('warehouse');
        allow update: if can('RECORD_STOCK_MOVEMENTS')
                      && resource.data.outAt == null
                      && request.resource.data.outAt is int
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outAt', 'odoOut', 'outByName', 'updatedAt']);
        allow delete: if false;
      }
      // Where each place stands on the map (web/tm/roadmap.js): set by a manager.
      match /tmsPlaces/{placeId} {
        allow read: if tmsReader();
        allow create, update: if tmsManager() && request.resource.data.lat is number && request.resource.data.lng is number
                              && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
                              && request.resource.data.lng >= -180 && request.resource.data.lng <= 180;
        allow delete: if tmsManager();
      }
      match /tmsTrips/{tripId} {
        allow read: if tmsReader() && inMyBranch(resource.data);
        allow create: if can('RECORD_STOCK_MOVEMENTS')
                      && inMyBranch(request.resource.data)
                      && request.resource.data.createdByUid == request.auth.uid
                      && request.resource.data.status == 'PLANNED'
                      && request.resource.data.stops is list
                      && request.resource.data.stops.size() > 0
                      && !moduleOff('warehouse');
        allow update: if can('RECORD_STOCK_MOVEMENTS')
                      && inMyBranch(resource.data)
                      && resource.data.status in ['PLANNED', 'LOADING', 'ON_ROAD']
                      && request.resource.data.status in ['PLANNED', 'LOADING', 'ON_ROAD', 'DONE', 'CANCELLED']
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'stops', 'loadingAt', 'departedAt', 'doneAt', 'cancelledAt', 'cancelledByName', 'updatedAt', 'lastPos', 'dock']);
        allow delete: if false;
      }

      // --------------------------------------------------- month-end stock
      //
      // One place's stock and its value at cost at the end of a month, for
      // the accounts ("2026-09_-" for the main shop). Written once, never
      // changed: a closed month stays closed. The morning job writes the
      // ones nobody closed by hand.
      match /stockClosings/{closingId} {
        allow read: if (can('RECORD_STOCK_MOVEMENTS') || can('WH_PURCHASE') || can('POS_MANAGE') || can('WH_APPROVE') || can('POS_REPORTS'))
                    && inMyBranch(resource.data);
        allow create: if (can('WH_APPROVE') || can('POS_MANAGE') || isAdmin())
                      && inMyBranch(request.resource.data)
                      && request.resource.data.lines is list
                      && request.resource.data.month is string;
        allow update, delete: if false;
      }

      // ------------------------------------------------------ JSOX Books
      //
      // The company's accounts (web/bk/, the sums in web/js/books.js). Who
      // keeps them: BOOKS_POST (and BOOKS_ADMIN, who also sets the company
      // details, the chart and the lock date). BOOKS_VIEW only reads.
      //
      // The journal is written once and never changed: a mistake is put
      // right by a reversing entry. Nothing is dated on or before the lock
      // date (a closed period stays closed). An issued document only moves
      // to void, or takes its e-invoice status; its lines never change.
      function booksPath() {
        return /databases/$(database)/documents/workspaces/$(ws)/bkMeta/settings;
      }
      function bookReader() {
        return can('BOOKS_VIEW') || can('BOOKS_POST') || can('BOOKS_ADMIN');
      }
      function bookkeeper() {
        return (can('BOOKS_POST') || can('BOOKS_ADMIN')) && !booksOff();
      }
      function lockDate() {
        return exists(booksPath()) ? get(booksPath()).data.get('lockDate', 0) : 0;
      }
      function openDate(d) {
        return d is int && d > lockDate();
      }

      match /bkMeta/{docId} {
        allow read: if bookReader();
        allow delete: if false;
        allow create, update: if (docId == 'settings' && can('BOOKS_ADMIN') && !booksOff())
                     || (docId == 'chart' && (can('BOOKS_ADMIN') || (bookkeeper() && !exists(/databases/$(database)/documents/workspaces/$(ws)/bkMeta/chart))))
                     || (docId == 'counters' && bookkeeper());
      }

      match /bkContacts/{contactId} {
        allow read: if bookReader();
        allow create, update: if bookkeeper() && request.resource.data.name is string && request.resource.data.name != '';
        allow delete: if false;
      }

      match /bkJournal/{entryId} {
        allow read: if bookReader();
        allow create: if bookkeeper()
                      && request.resource.data.lines is list
                      && request.resource.data.lines.size() >= 2
                      && request.resource.data.lines.size() <= 300
                      && openDate(request.resource.data.date)
                      && request.resource.data.createdByUid == request.auth.uid;
        allow update, delete: if false;
      }

      match /bkDocs/{docId} {
        allow read: if bookReader();
        allow create: if bookkeeper()
                      && request.resource.data.status in ['DRAFT', 'ISSUED']
                      && request.resource.data.lines is list
                      && request.resource.data.lines.size() <= 300
                      && openDate(request.resource.data.date)
                      && request.resource.data.createdByUid == request.auth.uid;
        // A draft is still being written.
        allow update: if bookkeeper()
                      && resource.data.status == 'DRAFT'
                      && request.resource.data.status in ['DRAFT', 'ISSUED']
                      && request.resource.data.lines is list
                      && request.resource.data.lines.size() <= 300
                      && openDate(request.resource.data.date)
                      && keepsAuthor(resource.data);
        // An issued one: voided (in an open period), or its e-invoice noted.
        allow update: if bookkeeper()
                      && resource.data.status == 'ISSUED'
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'voidedAt', 'voidedByName', 'voidJournalId', 'einvoice', 'updatedAt'])
                      && (request.resource.data.status == 'ISSUED'
                          || (request.resource.data.status == 'VOID' && openDate(resource.data.date)));
        allow delete: if bookkeeper() && resource.data.status == 'DRAFT';
      }

      match /bkPayments/{paymentId} {
        allow read: if bookReader();
        allow create: if bookkeeper()
                      && request.resource.data.status == 'POSTED'
                      && request.resource.data.amountSen is int
                      && request.resource.data.amountSen > 0
                      && openDate(request.resource.data.date)
                      && request.resource.data.createdByUid == request.auth.uid;
        allow update: if bookkeeper()
                      && resource.data.status == 'POSTED'
                      && request.resource.data.status == 'VOID'
                      && openDate(resource.data.date)
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'voidedAt', 'voidedByName', 'voidJournalId', 'updatedAt']);
        allow delete: if false;
      }

      // -------------------------------------------- POS: register settings
      //
      // Receipt header, tax, service charge, payment methods, tables.
      // Every member reads it so any till can print a receipt.
      // Suppliers are the buyer's as much as the till manager's.
      match /pos/suppliers {
        allow write: if can('WH_PURCHASE');
      }

      match /pos/{docId} {
        allow read: if active();
        allow write: if can('POS_MANAGE') && docId != 'settings';
      }

      // The till's settings. Its mode (restaurant, supermarket, retail) is
      // chosen once by whoever sets the till up; changing it afterwards is
      // an admin's decision (the website asks for their password again).
      match /pos/settings {
        function modeKept() {
          return resource == null
                 || resource.data.get('mode', '') in ['', 'BOTH']
                 || request.resource.data.get('mode', '') == resource.data.get('mode', '');
        }
        allow write: if can('POS_MANAGE') && (modeKept() || isAdmin());
      }

      // -------------------------------------------------- POS connections
      //
      // Holds the customer's own access token for their till system, so it
      // is readable only by someone who administers the company -- the same
      // person who generated that token in the till's back office.
      match /integrations/{name} {
        allow read, write: if can('CHANGE_PERMISSION');
      }

      // --------------------------------------------------------- templates

      match /templates/{templateId} {
        allow read: if active();
        allow create: if can('CREATE_TEMPLATE')
                      || (signedIn() && isAdmin());
        allow update: if can('EDIT_TEMPLATE');
        allow delete: if can('DELETE_TEMPLATE');
      }

      // ------------------------------------------------------- stock checks

      match /stockChecks/{checkId} {

        function existing() { return resource.data; }
        function frozen() { return existing().status == 'LOCKED'; }

        // Your own counts are yours to see whichever branch they were filed
        // under. Beyond being the obvious answer, it is what lets a worker's
        // "my counts" query (createdByUid == me) be proven safe on its own,
        // with no branch filter that would need a composite index.
        allow read: if (inMyBranch(existing()) || isOwner(existing().createdByUid))
                    && (can('VIEW_ALL_HISTORY')
                        || (can('VIEW_OWN_HISTORY') && isOwner(existing().createdByUid)));

        // A stock check is the unit of work, which makes it the honest
        // place to put the commercial lever: an expired company keeps every
        // record it has and cannot start the next count.
        //
        // Filed only under a branch the counter belongs to. Otherwise a
        // branch account could start a count in another shop that it then
        // could not open in History -- and that shop could.
        allow create: if can('CREATE_STOCK_CHECK')
                      && request.resource.data.createdByUid == request.auth.uid
                      && inMyBranch(request.resource.data)
                      && licenceAllowsNewWork()
                      && !moduleOff('app');

        // A locked record moves only for someone who can unlock it.
        allow update: if keepsAuthor(existing())
                      && (!frozen() || can('UNLOCK_STOCK'))
                      && (can('EDIT_ANY_STOCK')
                          || can('MARK_REVIEWED')
                          || can('LOCK_STOCK')
                          || (can('EDIT_OWN_STOCK') && isOwner(existing().createdByUid)));

        allow delete: if (!frozen() || can('UNLOCK_STOCK'))
                      && (can('DELETE_ANY_STOCK')
                          || (can('DELETE_OWN_STOCK') && isOwner(existing().createdByUid)));

        function parentCheck() {
          return get(/databases/$(database)/documents/workspaces/$(ws)/stockChecks/$(checkId)).data;
        }
        function parentFrozen() { return parentCheck().status == 'LOCKED'; }
        function parentOwner() { return parentCheck().createdByUid; }

        // The same test as reading the check itself. Without the branch half,
        // another shop's count was hidden from the list but its lines were
        // still readable to anyone who had its id.
        function mayReadParent() {
          return (inMyBranch(parentCheck()) || isOwner(parentOwner()))
                 && (can('VIEW_ALL_HISTORY')
                     || (can('VIEW_OWN_HISTORY') && isOwner(parentOwner())));
        }

        function mayWriteParent() {
          return (!parentFrozen() || can('UNLOCK_STOCK'))
                 && (can('EDIT_ANY_STOCK')
                     || (can('EDIT_OWN_STOCK') && isOwner(parentOwner())));
        }

        match /items/{itemId} {
          allow read: if mayReadParent();
          allow create: if (can('SCAN_BARCODE') || can('VOICE_INPUT') || can('CREATE_STOCK_CHECK'))
                        && !parentFrozen()
                        && (isOwner(parentOwner()) || can('EDIT_ANY_STOCK'));
          allow update, delete: if mayWriteParent();
        }

        match /photos/{photoId} {
          allow read: if mayReadParent();
          allow create: if can('TAKE_PHOTO')
                        && !parentFrozen()
                        && (isOwner(parentOwner()) || can('EDIT_ANY_STOCK'));
          allow update, delete: if mayWriteParent();
        }
      }

      // --------------------------------------------------------- audit log

      match /auditLog/{entryId} {
        // Append-only by design: anyone active may add an entry attributed to
        // themselves, and nobody — admin included — may rewrite or remove one.
        // That is the whole point of keeping the trail.
        allow read: if can('VIEW_AUDIT_LOG');
        allow create: if active() && request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }

      // The reference-number counter is the one thing under meta/ that a
      // counter has to write: opening a stock check claims a block of numbers
      // from it, and anyone who may open one must be able to. It holds a
      // tally per month and nothing else, so nothing is exposed by letting
      // them.
      match /meta/counters {
        allow read: if active();
        allow write: if can('CREATE_STOCK_CHECK');
      }

      match /meta/{docId} {
        // Members may read the company name and see the code they must give
        // out; nobody outside the workspace can, which is what stops the
        // join code being discovered rather than told.
        allow read: if active();
        allow write: if isAdmin();
      }
    }
  }
}
