{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/*.test.mjs",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/pos/**",
        "destination": "/pos/index.html"
      },
      {
        "source": "/warehouse/**",
        "destination": "/warehouse/index.html"
      },
      {
        "source": "/count/**",
        "destination": "/count/index.html"
      },
      {
        "source": "/app/**",
        "destination": "/app/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/pos/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "source": "/warehouse/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "source": "/app/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "source": "/count/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|webp|svg)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "**/*.webm",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "/download/*.apk",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"StockCheck.apk\""
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/ecommerce/",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/en/ecommerce/",
        "destination": "/en/",
        "type": 301
      },
      {
        "source": "/ms/ecommerce/",
        "destination": "/ms/",
        "type": 301
      }
    ]
  }
}
